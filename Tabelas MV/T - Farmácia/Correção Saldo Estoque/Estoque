SELECT e.cd_ent_pro,
       e.dt_entrada,
       e.tp_documento_entrada,
       e.cd_estoque,
       e.cd_fornecedor,
       i.cd_produto,
       l.cd_lote,
       l.qt_ent_pro
FROM dbamv.ent_pro e,
     dbamv.itent_pro i,
     dbamv.itlot_ent l
WHERE e.cd_ent_pro = i.cd_ent_pro
  AND i.cd_itent_pro = l.cd_itent_pro
  AND i.cd_produto = 20361
  AND l.cd_lote IS NULL
  --AND l.cd_lote = 'N395502'
ORDER BY dt_entrada DESC

