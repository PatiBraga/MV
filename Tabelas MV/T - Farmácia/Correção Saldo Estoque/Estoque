SELECT m.cd_mvto_estoque,
       m.tp_mvto_estoque,
       m.dt_mvto_estoque,
       m.cd_estoque,
       m.cd_estoque_destino,
       m.cd_atendimento,
       i.cd_produto,
       i.CD_FORNECEDOR,
       i.cd_lote, 
       i.qt_movimentacao
FROM dbamv.mvto_estoque m,
     dbamv.itmvto_estoque i
WHERE m.cd_mvto_estoque = i.cd_mvto_estoque
AND i.cd_produto = 20361
AND i.cd_lote IN ('I3465065')
ORDER BY dt_mvto_estoque DESC

