- e.qt_estoque_consumido
+ e.qt_estoque_transferencia
- e.qt_baixada ) saldo_atual, e.*
FROM dbamv.est_consig_forn e
WHERE cd_produto = 20361
--AND cd_fornecedor =  3172
AND cd_estoque = 32

