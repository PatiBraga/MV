-- Validação tabela PRE_MED - PROBLEMA NA PRESCRIÇÃO
SELECT 
    pm.CD_ATENDIMENTO,
    pm.CD_PRE_MED AS CD_PRESCRICAO,
    pm.DT_PRE_MED AS DT_PRESCRICAO,
    pm.HR_PRE_MED AS HR_PRESCRICAO,
    pm.DT_VALIDADE,
    pm.CD_PRESTADOR,
    pr.NM_PRESTADOR,
    pm.SN_FECHADO,
    CASE 
        WHEN pm.SN_FECHADO = 'S' THEN 'FECHADA'
        WHEN pm.SN_FECHADO = 'N' THEN 'ABERTA'
        ELSE 'INDEFINIDO'
    END AS DS_STATUS_PRESCRICAO
FROM 
    DBAMV.PRE_MED pm
    INNER JOIN DBAMV.PRESTADOR pr ON pm.CD_PRESTADOR = pr.CD_PRESTADOR
WHERE 
    pm.CD_ATENDIMENTO = 1221948 -- Substitua pelo número do atendimento desejado (ex: 1221948)
--  AND  pm.CD_PRE_MED = '3250237'
ORDER BY 
    pm.DT_PRE_MED DESC, 
    pm.HR_PRE_MED DESC;

