       dh_impresso   = TO_DATE('15/09/2026', 'DD/MM/YYYY'),
       dh_documento  = TO_DATE('15/09/2026', 'DD/MM/YYYY')
 WHERE cd_atendimento = 1221948
   AND cd_documento_clinico IN (9065770, 9064193); 

