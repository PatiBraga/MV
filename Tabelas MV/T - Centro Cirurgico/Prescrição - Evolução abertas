-- Prescrição / Evolução abertas 

SELECT
       PRE_MED.cd_atendimento,
       PRE_MED.CD_PRE_MED,
       PRESTADOR.NM_PRESTADOR,
       TIP_PRESTA.NM_TIP_PRESTA,
       TO_CHAR(PRE_MED.DT_PRE_MED, 'DD/MM/YYYY') DATA,
       TO_CHAR(PRE_MED.HR_PRE_MED, 'HH24:MI') HORA,
       DECODE(PRE_MED.TP_PRE_MED,
              'M', 'MEDICA',
              'A', 'INTERNADO',
              'N', 'EVOLUAOO NUTRICIONAL',
              'O', 'EVOLUCAO OUTROS PRESTADORES',
              'E', 'ENFERMAGEM',
              'S', 'EVOLUCAO DE FISIOTERAPIA',
              'F', 'FUTURA'
             ) TIPO,
       CASE WHEN PRE_MED.cd_objeto IN (763,89,92,109,91,88,90,94,93) THEN 'E' ELSE 'P' END SN_EVOLUCAO,
       ATENDIME.CD_ATENDIMENTO,
       NM_PACIENTE,
       TRUNC(PRE_MED.DT_PRE_MED) DATA_PRESC
FROM PRE_MED, PRESTADOR, TIP_PRESTA, PACIENTE, ATENDIME
WHERE PRESTADOR.CD_PRESTADOR = PRE_MED.CD_PRESTADOR
  AND TIP_PRESTA.CD_TIP_PRESTA = PRESTADOR.CD_TIP_PRESTA
  AND ATENDIME.CD_ATENDIMENTO = PRE_MED.CD_ATENDIMENTO
  AND ATENDIME.CD_PACIENTE = PACIENTE.CD_PACIENTE
  AND FL_IMPRESSO = 'N'
  AND ATENDIME.TP_ATENDIMENTO = 'I'
  AND PRE_MED.CD_ATENDIMENTO = 1221948
--  AND cd_pre_med =  3250237

  --- FILTROS ---
--  AND (TRIM({V_CD_ATENDIMENTO}) IS NULL
--   OR {V_CD_ATENDIMENTO} = 0
--   OR ATENDIME.CD_ATENDIMENTO = {V_CD_ATENDIMENTO})
--  AND To_Date(PRE_MED.DT_PRE_MED, 'DD/MM/YYYY') BETWEEN To_Date(@PDATA_INICIAL, 'DD/MM/YYYY') AND To_Date(@PDATA_FINAL, 'DD/MM/YYYY')

ORDER BY DATA_PRESC DESC
