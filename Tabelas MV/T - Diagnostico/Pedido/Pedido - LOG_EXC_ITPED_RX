SELECT
    fk.table_name       AS tabela_dependente,
    fkc.column_name     AS coluna_dependente,
    pk.owner            AS proprietario_tabela_mae,
    pk.table_name       AS tabela_mae,
    pkc.column_name     AS coluna_tabela_mae,
    fk.constraint_name  AS restricao
FROM all_constraints fk
JOIN all_cons_columns fkc
    ON fkc.owner = fk.owner
   AND fkc.constraint_name = fk.constraint_name
JOIN all_constraints pk
    ON pk.owner = fk.r_owner
   AND pk.constraint_name = fk.r_constraint_name
JOIN all_cons_columns pkc
    ON pkc.owner = pk.owner
   AND pkc.constraint_name = pk.constraint_name
   AND pkc.position = fkc.position
WHERE fk.owner = 'DBAMV'
  AND fk.constraint_name = 'CNT_LOG_EXC_EXA_RX_US_2_FK'
  AND fk.constraint_type = 'R'
ORDER BY fkc.position;
/

SELECT c.owner,
       c.table_name      AS tabela_filha,
       c.constraint_name,
       p.table_name      AS tabela_referenciada
FROM all_constraints c
JOIN all_constraints p
  ON p.owner = c.r_owner
 AND p.constraint_name = c.r_constraint_name
WHERE c.owner = 'DBAMV'
  AND c.constraint_name = 'CNT_LOG_EXC_ITPED_RX_1_FK'
  AND c.constraint_type = 'R';

