-- Caixa

SELECT 
    c.CD_CAIXA,
    c.DS_CAIXA,
    c.VL_SALDO,
    c.VL_INICIO_SALDO,
    c.VL_SALDO_PRE_DATADOS,
    c.VL_SALDO_CARTAO,
    m.CD_MULTI_EMPRESA,
    m.DS_MULTI_EMPRESA,
    p.CD_REDUZIDO,
    p.CD_CONTABIL,
    p.DS_CONTA
FROM 
    DBAMV.CAIXA c
    INNER JOIN DBAMV.MULTI_EMPRESAS m ON c.CD_MULTI_EMPRESA = m.CD_MULTI_EMPRESA
    LEFT JOIN DBAMV.PLANO_CONTAS p ON c.CD_REDUZIDO = p.CD_REDUZIDO
WHERE 
    c.VL_SALDO < 0
ORDER BY 
    c.VL_SALDO ASC;
