create or replace TRIGGER dbamv.trg_tiss_comunica_operadora
 AFTER
   INSERT OR DELETE OR UPDATE OF cd_convenio, dt_alta
 ON dbamv.atendime
REFERENCING NEW AS NEW OLD AS OLD
 FOR EACH ROW
DECLARE
  vTIPO           VARCHAR2(1);
  eSAIDA          EXCEPTION;
  nACHOU          NUMBER;
  dDT_COMUNICACAO DATE;

BEGIN
  IF NVL(:NEW.TP_ATENDIMENTO,:OLD.TP_ATENDIMENTO) <> 'I' THEN
    RAISE eSAIDA;
  END IF;

  IF NOT(DBAMV.PACK_SITE.F_USA_WEBSERVICE('COMUNICACAO_BENEFICIARIO',NVL(:NEW.CD_CONVENIO,:OLD.CD_CONVENIO))) THEN
    RAISE eSAIDA;
  END IF;
  IF INSERTING THEN
    vTIPO:= 'I';
    dDT_COMUNICACAO:= :NEW.DT_ATENDIMENTO;
  ELSIF UPDATING AND :NEW.CD_MOT_ALT IS NOT NULL THEN
    vTIPO:= 'A';
    dDT_COMUNICACAO:= :NEW.DT_ALTA;
  END IF;

  dDT_COMUNICACAO:= NVL(dDT_COMUNICACAO,SYSDATE);
  IF vTIPO IS NULL THEN
    RAISE eSAIDA;
  END IF;

  SELECT COUNT(*)
    INTO nACHOU
    FROM DBAMV.COMUNICACAO_BENEFICIARIO
    WHERE CD_ATENDIMENTO = NVL(:NEW.CD_ATENDIMENTO,:OLD.CD_ATENDIMENTO)
     AND TP_COMUNICACAO  = vTIPO;
  IF nACHOU > 0 THEN
    RAISE eSAIDA;
  END IF;

  INSERT INTO DBAMV.COMUNICACAO_BENEFICIARIO
	  (CD_ATENDIMENTO
	  ,CD_CONVENIO
	  ,CD_PACIENTE
	  ,DT_COMUNICACAO
	  ,TP_COMUNICACAO
	  ,CD_MULTI_EMPRESA
	  ,TP_STATUS
	  ,DT_OCORRENCIA)
  VALUES
	  (NVL(:NEW.CD_ATENDIMENTO,:OLD.CD_ATENDIMENTO)
	  ,NVL(:NEW.CD_CONVENIO,:OLD.CD_CONVENIO)
	  ,NVL(:NEW.CD_PACIENTE,:OLD.CD_PACIENTE)
	  ,dDT_COMUNICACAO
	  ,vTIPO
	  ,NVL(:NEW.CD_MULTI_EMPRESA,:OLD.CD_MULTI_EMPRESA)
	  ,'A'
	  ,SYSDATE);
EXCEPTION
  WHEN eSAIDA THEN
    NULL;

END;